# Local Convex CLI deployment selector. This is not a secret, but it stays in
# .env.local and must identify the same shared development deployment as the URLs below.
CONVEX_DEPLOYMENT=dev:your-shared-deployment

# Public Convex client URL for that deployment. VITE_* values are exposed to the browser.
VITE_CONVEX_URL=https://your-shared-deployment.convex.cloud

# Public Convex HTTP Actions/site URL for the same deployment. Never put secrets in VITE_* values.
VITE_CONVEX_SITE_URL=https://your-shared-deployment.convex.site
